{
  "name": "@nexint/lumina",
  "version": "0.8.3",
  "description": "Node.js framework lol",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test": "node --test",
    "publish:dev": "npm version patch --no-git-tag-version && git add -A && git commit -m \"Development release\" && git push origin dev && npm publish --tag dev"
  },
  "keywords": [],
  "author": "Nexint",
  "license": "SEE LICENSE IN LICENSE.md",
  "private": false,
  "type": "commonjs",
  "exports": {
    ".": "./index.js",
    "./core/*": "./functions/core/*.js",
    "./core/*.mjs": "./functions/core/*.mjs",
    "./framework": "./config/core/framework.js",
    "./preload/*": "./preload/*.js",
    "./power": "./functions/core/powerCycle.js",
    "./perf": "./preload/core/perf.js"
  },
  "imports": {
    "#config/*": "./config/*.js",
    "#functions/*": "./functions/*.js",
    "#functions/*.mjs": "./functions/*.mjs",
    "#preload/*": "./preload/*.js",
    "#boot": "./boot.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Nexint-Labs/Lumina.git"
  },
  "homepage": "https://github.com/Nexint-Labs/Lumina",
  "bugs": {
    "url": "https://github.com/Nexint-Labs/Lumina/issues"
  }
}
